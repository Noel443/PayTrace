# 将此文件复制为 .env，填写后重新运行 npm start。不要将 .env 提交到 Git。
# compatible：兼容 Chat Completions 接口的服务；ollama：本地 Ollama。
AI_PROVIDER=compatible
# 填写服务商的接口根地址，程序会追加 /chat/completions。
# 示例：https://api.deepseek.com
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# 本地 Ollama 示例（替换上方配置，模型须已安装）：
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=qwen3:8b


# NATAPP 公网来源白名单（需 MySQL 登录模式）；多个地址用逗号分隔。
# PUBLIC_ORIGINS=http://your-domain.natappfree.cc
PUBLIC_ORIGINS=
